{
  "_comment": "Populate command/args/env from your global ~/.claude.json mcpServers entries. context7 is intentionally NOT declared here — assumed available via user-global config (see CLAUDE.md).",
  "mcpServers": {
    "xray": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
